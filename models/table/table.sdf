  <model name="table">

    <static>true</static>

    <link name="table_link">

      <visual name="table_visual">

        <geometry>

          <mesh>
            <uri>model://table/mesh/table.dae</uri>
          </mesh>

        </geometry>

      </visual>

      <collision name="table_collision">

        <geometry>

          <mesh>
            <uri>model://table/mesh/table.dae</uri>
          </mesh>

        </geometry>

      </collision>

    </link>

  </model>

</sdf>