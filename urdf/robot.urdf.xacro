<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="pointcloud_robot">

  <!-- ================================================= -->
  <!-- Robot Dimensions                                  -->
  <!-- ================================================= -->

  <xacro:property name="base_length" value="0.50"/>
  <xacro:property name="base_width"  value="0.40"/>
  <xacro:property name="base_height" value="0.20"/>

  <xacro:property name="wheel_radius" value="0.10"/>
  <xacro:property name="wheel_width"  value="0.05"/>

  <xacro:property name="caster_radius" value="0.06"/>


  <!-- ================================================= -->
  <!-- Base Link                                         -->
  <!-- ================================================= -->

  <link name="base_link">

    <visual>

      <origin xyz="0 0 0"/>

      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>

      <material name="blue">
        <color rgba="0.1 0.3 0.8 1.0"/>
      </material>

    </visual>

    <collision>

      <origin xyz="0 0 0"/>

      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>

    </collision>

    <inertial>

      <mass value="10.0"/>

      <inertia
        ixx="0.20"
        ixy="0.0"
        ixz="0.0"
        iyy="0.30"
        iyz="0.0"
        izz="0.40"/>

    </inertial>

  </link>


  <!-- ================================================= -->
  <!-- Left Drive Wheel                                 -->
  <!-- ================================================= -->

  <link name="left_wheel">

    <visual>

      <origin rpy="1.5708 0 0"/>

      <geometry>
        <cylinder
          radius="${wheel_radius}"
          length="${wheel_width}"/>
      </geometry>

      <material name="black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>

    </visual>

    <collision>

      <origin rpy="1.5708 0 0"/>

      <geometry>
        <cylinder
          radius="${wheel_radius}"
          length="${wheel_width}"/>
      </geometry>

    </collision>

    <inertial>

      <mass value="1.0"/>

      <inertia
        ixx="0.01"
        ixy="0.0"
        ixz="0.0"
        iyy="0.01"
        iyz="0.0"
        izz="0.01"/>

    </inertial>

  </link>


  <!-- ================================================= -->
  <!-- Right Drive Wheel                                -->
  <!-- ================================================= -->

  <link name="right_wheel">

    <visual>

      <origin rpy="1.5708 0 0"/>

      <geometry>
        <cylinder
          radius="${wheel_radius}"
          length="${wheel_width}"/>
      </geometry>

      <material name="black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>

    </visual>

    <collision>

      <origin rpy="1.5708 0 0"/>

      <geometry>
        <cylinder
          radius="${wheel_radius}"
          length="${wheel_width}"/>
      </geometry>

    </collision>

    <inertial>

      <mass value="1.0"/>

      <inertia
        ixx="0.01"
        ixy="0.0"
        ixz="0.0"
        iyy="0.01"
        iyz="0.0"
        izz="0.01"/>

    </inertial>

  </link>


  <!-- ================================================= -->
  <!-- Caster Wheel 1                                 -->
  <!-- ================================================= -->

  <link name="caster_wheel1">

    <visual>

      <origin xyz="0 0 0"/>

      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>

      <material name="caster_material">
        <color rgba="0.15 0.15 0.15 1.0"/>
      </material>

    </visual>

    <collision>

      <origin xyz="0 0 0"/>

      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>

    </collision>

    <inertial>

      <mass value="0.5"/>

      <inertia
        ixx="0.002"
        ixy="0.0"
        ixz="0.0"
        iyy="0.002"
        iyz="0.0"
        izz="0.002"/>

    </inertial>

  </link>


<!-- ================================================= -->
  <!-- Caster Wheel 2                                 -->
  <!-- ================================================= -->

  <link name="caster_wheel2">

    <visual>

      <origin xyz="0 0 0"/>

      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>

      <material name="caster_material">
        <color rgba="0.15 0.15 0.15 1.0"/>
      </material>

    </visual>

    <collision>

      <origin xyz="0 0 0"/>

      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>

    </collision>

    <inertial>

      <mass value="0.5"/>

      <inertia
        ixx="0.002"
        ixy="0.0"
        ixz="0.0"
        iyy="0.002"
        iyz="0.0"
        izz="0.002"/>

    </inertial>

  </link>

  <!-- ================================================= -->
  <!-- Left Wheel Joint                                 -->
  <!-- ================================================= -->

  <joint
    name="left_wheel_joint"
    type="continuous">

    <parent link="base_link"/>
    <child link="left_wheel"/>

    <origin
      xyz="0 0.225 -0.10"
      rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

  </joint>


  <!-- ================================================= -->
  <!-- Right Wheel Joint                                -->
  <!-- ================================================= -->

  <joint
    name="right_wheel_joint"
    type="continuous">

    <parent link="base_link"/>
    <child link="right_wheel"/>

    <origin
      xyz="0 -0.225 -0.10"
      rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

  </joint>


  <!-- ================================================= -->
  <!-- Caster Joint                                     -->
  <!-- ================================================= -->

  <joint
    name="caster_joint1"
    type="fixed">

    <parent link="base_link"/>
    <child link="caster_wheel1"/>

    <!-- Rear of robot -->
    <origin
      xyz="-0.20 0 -0.14"
      rpy="0 0 0"/>

  </joint>

  <!-- ================================================= -->
  <!-- Caster Joint                                     -->
  <!-- ================================================= -->

  <joint
    name="caster_joint2"
    type="fixed">

    <parent link="base_link"/>
    <child link="caster_wheel2"/>

    <!-- Rear of robot -->
    <origin
      xyz="0.20 0 -0.14"
      rpy="0 0 0"/>

  </joint>

    <!-- ================================================= -->
  <!-- Depth Camera Link                                -->
  <!-- ================================================= -->

  <link name="camera_link">

    <visual>

      <origin xyz="0 0 0"/>

      <geometry>
        <box size="0.08 0.08 0.05"/>
      </geometry>

      <material name="camera_material">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>

    </visual>

    <collision>

      <origin xyz="0 0 0"/>

      <geometry>
        <box size="0.08 0.08 0.05"/>
      </geometry>

    </collision>

    <inertial>

      <mass value="0.1"/>

      <inertia
        ixx="0.0001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0001"
        iyz="0.0"
        izz="0.0001"/>

    </inertial>

  </link>


  <!-- ================================================= -->
  <!-- Camera Joint                                     -->
  <!-- ================================================= -->

  <joint
    name="camera_joint"
    type="fixed">

    <parent link="base_link"/>
    <child link="camera_link"/>

    <!-- Camera mounted at front/top of robot -->
    <origin
      xyz="0.20 0 0.18"
      rpy="0 0 0"/>

  </joint>

    <!-- ================================================= -->
  <!-- Gazebo Depth Camera                              -->
  <!-- ================================================= -->

  <gazebo reference="camera_link">

  <sensor name="rgbd_camera" type="rgbd_camera">

    <pose>0 0 0 0 0 0</pose>

    <topic>/camera</topic>
    <gz_frame_id>camera_link</gz_frame_id>

    <update_rate>30</update_rate>

    <camera>

      <horizontal_fov>1.047</horizontal_fov>

      <image>
        <width>640</width>
        <height>480</height>
        <format>R8G8B8</format>
      </image>

      <clip>
        <near>0.05</near>
        <far>10.0</far>
      </clip>

    </camera>

    <always_on>true</always_on>
    <visualize>true</visualize>

  </sensor>

</gazebo>

    <!-- ================================================= -->
  <!-- Gazebo Harmonic Differential Drive               -->
  <!-- ================================================= -->

  <gazebo>

    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">

      <!-- Wheel joints -->
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <!-- Wheel geometry -->
      <wheel_separation>0.45</wheel_separation>
      <wheel_radius>0.10</wheel_radius>

      <!-- ROS/Gazebo topics -->
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>

      <!-- Frames -->
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>

      <!-- Odometry publication -->
      <odom_publish_frequency>30</odom_publish_frequency>

      <!-- TF -->
      <tf_topic>/tf</tf_topic>

    </plugin>

  </gazebo>


</robot>
